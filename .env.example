# Supabase connection (see src/lib/supabase.ts).
# Copy to .env.local for local development. Both values are PUBLIC — they ship
# in the JavaScript bundle. Row-level security is what protects the data: every
# table grants access only to the `authenticated` role, so these are useless
# without a signed-in WCS account. Never put the service_role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
