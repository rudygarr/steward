# Microsoft Entra ID sign-in (see src/lib/msal.ts).
# Copy to .env.local for local development. Both values are PUBLIC — they ship
# in the JavaScript bundle by design. A single-page app has no server to keep a
# secret in, so the SPA flow (auth code + PKCE) uses no client secret at all.
# If anyone hands you a client secret for this, it's the wrong registration type.

# Application (client) ID from the Entra app registration
VITE_ENTRA_CLIENT_ID=

# Directory (tenant) ID of the WCS tenant — restricts sign-in to WCS accounts
VITE_ENTRA_TENANT_ID=
